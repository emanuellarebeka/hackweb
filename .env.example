# RPC principal para deploy em Ethereum Sepolia.
# Use o endpoint do Alchemy, Infura ou outro provedor compatível.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/SUA_API_KEY

# Opcional: rede principal Ethereum. Use apenas se realmente souber o que está fazendo.
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/SUA_API_KEY

# Alternativas aceitas pela configuração:
# ALCHEMY_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/SUA_API_KEY
# INFURA_RPC_URL=https://sepolia.infura.io/v3/SUA_API_KEY
# RPC_URL=https://eth-sepolia.g.alchemy.com/v2/SUA_API_KEY

# Chave privada da carteira deployer.
# Pode ser com ou sem 0x.
PRIVATE_KEY=sua_chave_privada_aqui

# Nome alternativo aceito:
# DEPLOYER_PRIVATE_KEY=sua_chave_privada_aqui

# Opcional, para verificação no Etherscan.
ETHERSCAN_API_KEY=sua_api_key_do_etherscan

# Preenchido automaticamente pelo script de deploy.
CONTRACT_ADDRESS=
DEPLOY_NETWORK=
